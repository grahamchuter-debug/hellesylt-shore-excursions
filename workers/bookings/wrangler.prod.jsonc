{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hellesylt-bookings-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hellesylt-bookings-prod",
      "database_id": "97a8314c-21b7-4433-8970-141be4979511",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_MODE": "live",
    "BOOKINGS_ENABLED": "true",
    "EMAIL_SENDING_ENABLED": "true",
    "EMAIL_FROM": "bookings@notifications.wowatour.com",
    "EMAIL_FROM_NAME": "Hellesylt Shore Excursions",
    "EMAIL_REPLY_TO": "hello@hellesyltshoreexcursions.com",
    "CORS_ALLOWED_ORIGINS": "https://hellesyltshoreexcursions.com,https://www.hellesyltshoreexcursions.com",
    "SITE_BASE_URL": "https://hellesyltshoreexcursions.com",
    "ORIGINATING_SITE": "hellesyltshoreexcursions.com",
    "ORIGINATING_PORT": "Hellesylt, Norway",
    "OPERATOR_PORTAL_BASE_URL": "https://hellesylt-bookings-prod.dark-violet-8d91.workers.dev"
  }
}
